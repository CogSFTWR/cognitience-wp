{
  "name": "cognitience-wp",
  "version": "2.0.0",
  "description": "Cognitience WP — local-first word processor with liquid glass UI and Rust backend",
  "main": "electron/main.js",
  "author": "Cognitience",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node scripts/test-liquid-glass.js && node scripts/test-pdf-helpers.js",
    "test:pdf": "node scripts/test-pdf-helpers.js && node scripts/test-pdf-open.js",
    "test:glass": "node scripts/test-liquid-glass.js && node scripts/verify-glass-structure.js",
    "backend": "cargo run --release",
    "backend:build": "cargo build --release",
    "start": "cargo run",
    "electron": "electron .",
    "electron:dev": "cargo build --release && electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "cargo build --release && node scripts/make-icon.js && electron-builder --win portable",
    "dist:dir": "cargo build --release && node scripts/make-icon.js && electron-builder --win dir"
  },
  "build": {
    "appId": "com.cognitience.wp",
    "productName": "Cognitience WP",
    "copyright": "Copyright © Cognitience",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/cognition-wp.exe",
        "to": "backend/cognition-wp.exe"
      },
      {
        "from": "static",
        "to": "static"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CognitienceWP_v${version}.${ext}"
    },
    "portable": {
      "artifactName": "CognitienceWP_v${version}.${ext}"
    },
    "asar": true,
    "compression": "maximum"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maq-Swarm/cognitience-wp.git"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
